# ThaiLLM API (shared by the whole team — mind the quota)
THAILLM_API_KEY=your-api-key-here
THAILLM_BASE_URL=http://thaillm.or.th/api/v1

# Gatekeeper
GATEKEEPER_MODEL=openthaigpt-thaillm-8b-instruct-v7.2
GATEKEEPER_TIMEOUT_S=8
GATEKEEPER_MAX_TOKENS=1024    # classification reply incl. the model's <think> block (512 truncated ~4% of Thai rows)
GATEKEEPER_TEMPERATURE=0
#GATEKEEPER_CACHE_DIR=.cache/eval   # on-disk LLM response cache — eval only, leave unset in production

# API (uvicorn api.main:app)
HOST=0.0.0.0                  # only used by `python -m api.main`
PORT=8000
LOG_LEVEL=INFO
ANSWERER=stub                 # stub | rag  (rag imports rag.answerer:RagAnswerer)
ALLOWED_ORIGINS=http://localhost:3000,https://<your-app>.vercel.app
RATE_LIMIT_PER_MINUTE=30      # per client IP; 0 disables
LOG_CONTENT=0                 # 1 = include message text in request logs (debugging only)
TRUST_PROXY=0                 # 1 = take client IP from X-Forwarded-For
ANSWER_EVENT_TIMEOUT_S=60     # max silence between answerer events before an error event
STUB_TOKEN_DELAY_S=0.02       # stub answerer streaming delay per token

# Answer layer (ANSWERER=rag) — see rag/llm.py
RETRIEVER=fixture             # fixture | chroma (chroma = the vendored hybrid pipeline in retrieval/, see docs/retrieval-integration.md)
#FIXTURE_CHUNKS_PATH=tests/fixtures/chunks.jsonl
RAG_MODEL=openthaigpt-thaillm-8b-instruct-v7.2          # fact_lookup / descriptive answers
RAG_COMPARISON_MODEL=openthaigpt-thaillm-8b-instruct-v7.2   # question_kind=comparison; pathumma-thaillm-qwen3-8b-think-3.0.0 did arithmetic in the eval (see rag/llm.py)
RAG_FALLBACK_MODEL=openthaigpt-thaillm-8b-instruct-v7.2  # retried once if the primary yields nothing in time
RAG_REWRITE_MODEL=openthaigpt-thaillm-8b-instruct-v7.2   # follow-up rewrite / query translation
RAG_QUERY_REWRITE=1           # 0 = never rewrite follow-ups or translate non-Thai questions
RAG_TIMEOUT_S=30              # HTTP timeout; also the max stall between streamed deltas
RAG_FIRST_TOKEN_TIMEOUT_S=45  # max wait for the first visible token (thinking counts as waiting)
RAG_MAX_TOKENS=1500           # every ThaiLLM model emits a <think> block first; keep room for it
RAG_THINK_MAX_TOKENS=2500     # thinking model (comparisons)
RAG_TEMPERATURE=0
CONTEXT_TOKEN_BUDGET=6500     # estimated tokens of retrieved passages (chars/3 Thai, chars/4 other); 4500 was tuned for the fixture, 6500 for chroma
RETRIEVAL_K=12                # chunks per retrieval (8 for the fixture, 12 for chroma — see docs/retrieval-integration.md)
RETRIEVAL_MIN_SCORE=0.3       # fixture retriever: below this for every chunk -> fixed "not found" reply
RETRIEVAL_MIN_SCORE_CHROMA=0.0   # chroma retriever: same gate on the per-query normalised RRF score (top hit = 1.0)
# Chroma retriever internals (retrieval/retrieve.py): index with `python scripts/build_index.py` first
#RETRIEVE_CAND_K=40            # candidates per ranker (dense / BM25) before RRF fusion (their default 20; 40 = +11 pts hit rate)
#RRF_K=60                      # RRF constant
#CODE_BOOST=1.0                # RRF bonus when an 8-digit course code in the query matches chunk.course_code
#RERANK=0                      # 1 = BGE-reranker-v2-m3 on the fused candidates: hit rate 74 → 89 % but ~20 s/query and 8 GB RSS on CPU; RERANK_DEVICE=cpu on macOS
#CHROMA_DIR=retrieval/data/chroma  BM25_PATH=retrieval/data/bm25.pkl  CHUNKS_PATH=retrieval/data/chunks/all.jsonl
#RAG_CACHE_DIR=.cache/eval-answers   # eval only: on-disk completion cache
