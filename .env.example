# ThaiLLM API (shared by the whole team — mind the quota)
THAILLM_API_KEY=your-api-key-here
THAILLM_BASE_URL=http://thaillm.or.th/api/v1

# Gatekeeper
GATEKEEPER_MODEL=openthaigpt-thaillm-8b-instruct-v7.2
GATEKEEPER_TIMEOUT_S=8

# API (uvicorn api.main:app)
ANSWERER=stub                 # stub | rag  (rag imports rag.answerer:RagAnswerer)
ALLOWED_ORIGINS=http://localhost:3000,https://<your-app>.vercel.app
RATE_LIMIT_PER_MINUTE=30      # per client IP; 0 disables
LOG_CONTENT=0                 # 1 = include message text in request logs (debugging only)
TRUST_PROXY=0                 # 1 = take client IP from X-Forwarded-For
ANSWER_EVENT_TIMEOUT_S=60     # max silence between answerer events before an error event
STUB_TOKEN_DELAY_S=0.02       # stub answerer streaming delay per token
