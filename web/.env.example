# --- Supabase (optional; app runs in demo mode without these) ---
# Get from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google provider in Supabase Auth for "Continue with Google"

# --- Backend (FastAPI gatekeeper + RAG; see ../docs/api-contract.md) ---
# Server-side only (read by app/api/chat/route.ts, never exposed to the browser).
# Default http://localhost:8000 — start it with `scripts/dev.sh` from the repo root.
# If it is unreachable the chat streams a mock reply so the UI still works.
FASTAPI_URL=http://localhost:8000

# --- Deployment ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
