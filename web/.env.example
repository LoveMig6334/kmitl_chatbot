# --- Supabase Auth (Google OAuth + email/password) ---
# Project Settings → API. Leave both empty to run in demo mode (sign-in simulated in the browser,
# route protection off). Phase 1 introduces no new variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase dashboard → Authentication → URL Configuration: add
#   ${NEXT_PUBLIC_APP_URL}/auth/callback   (Google OAuth, email confirmation, password reset all land here)
# Authentication → Providers: enable Email and Google.

# --- Backend (FastAPI gatekeeper + RAG; see ../docs/api-contract.md) ---
# Server-side only (read by app/api/chat/route.ts, never exposed to the browser).
# Default http://localhost:8000 — start it with `scripts/dev.sh` from the repo root.
# If it is unreachable the chat streams a mock reply so the UI still works.
FASTAPI_URL=http://localhost:8000

# --- Deployment ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
