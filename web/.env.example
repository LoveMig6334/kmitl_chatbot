# --- Supabase (optional; app runs in demo mode without these) ---
# Get from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google provider in Supabase Auth for "Continue with Google"

# --- AI provider (optional; app streams mock responses without these) ---
# OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Deployment ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
